---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { languages, type Language } from '../i18n/ui';
import type { LocalizedLink } from '../i18n/routes';

interface Props {
  alternates: LocalizedLink[];
}
const { alternates } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
  { name: t('nav.publications'), href: `/${lang}/publications` },
  { name: t('nav.blog'), href: `/${lang}/blog` },
  { name: t('nav.teaching'), href: `/${lang}/teaching` },
  { name: t('nav.cv'), href: `/${lang}/cv` },
];
---

<header class="border-b bg-white sticky top-0 z-50">
  <div
    class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-4 relative"
  >
    <a
      href={`/${lang}/`}
      class="font-bold text-lg border-b-2 border-black pb-1 z-50 shrink-0"
    >
      {t('nav.home')}
    </a>

    <nav
      aria-label={t('nav.main')}
      class="hidden md:flex items-center space-x-6 text-sm text-slate-600"
    >
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="hover:text-black transition-colors font-medium whitespace-nowrap"
          >
            {link.name}
          </a>
        ))
      }
    </nav>

    <nav
      aria-label={t('nav.language')}
      class="ml-auto md:ml-0 flex gap-1 text-sm shrink-0"
    >
      {
        (Object.keys(languages) as Language[]).map((language) => {
          const alternate = alternates.find((item) => item.lang === language);
          const href = alternate?.path ?? `/${language}/blog/`;
          return (
            <a
              href={href}
              lang={language}
              hreflang={language}
              aria-current={language === lang ? 'true' : undefined}
              aria-label={
                alternate
                  ? languages[language]
                  : `${languages[language]} — ${t('nav.blog_language')}`
              }
              class:list={[
                'rounded px-2 py-1 focus-visible:outline-2 focus-visible:outline-offset-2',
                language === lang
                  ? 'bg-slate-900 text-white'
                  : 'text-slate-600 hover:bg-slate-100',
              ]}
            >
              {language.toUpperCase()}
            </a>
          );
        })
      }
    </nav>

    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-center items-center w-8 h-8 space-y-1.5 z-50 focus-visible:outline-2 focus-visible:outline-offset-2 group"
      aria-label={t('nav.menu')}
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span
        class="w-6 h-0.5 bg-slate-800 transition-all duration-300 ease-in-out origin-center id-bar-1"
      ></span>
      <span
        class="w-6 h-0.5 bg-slate-800 transition-all duration-300 ease-in-out origin-center id-bar-2"
      ></span>
      <span
        class="w-6 h-0.5 bg-slate-800 transition-all duration-300 ease-in-out origin-center id-bar-3"
      ></span>
    </button>

    <div
      id="mobile-menu"
      inert
      class="absolute top-full left-0 w-full bg-white border-b shadow-lg md:hidden transition-all duration-300 ease-in-out opacity-0 pointer-events-none -translate-y-2 z-40"
    >
      <nav
        aria-label={t('nav.main')}
        class="flex flex-col px-6 py-6 space-y-4 text-md font-medium text-slate-700"
      >
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="hover:text-black py-2 border-b border-slate-50 last:border-0 transition-colors"
            >
              {link.name}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</header>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const bar1 = document.querySelector('.id-bar-1');
  const bar2 = document.querySelector('.id-bar-2');
  const bar3 = document.querySelector('.id-bar-3');

  if (menuToggle && mobileMenu && bar1 && bar2 && bar3) {
    let isOpen = false;

    menuToggle.addEventListener('click', () => {
      isOpen = !isOpen;
      menuToggle.setAttribute('aria-expanded', isOpen.toString());
      mobileMenu.inert = !isOpen;

      if (isOpen) {
        mobileMenu.classList.remove(
          'opacity-0',
          'pointer-events-none',
          '-translate-y-2',
        );
        mobileMenu.classList.add(
          'opacity-100',
          'pointer-events-auto',
          'translate-y-0',
        );
        bar1.classList.add('translate-y-2', 'rotate-45');
        bar2.classList.add('opacity-0', 'scale-0');
        bar3.classList.add('-translate-y-2', '-rotate-45');
      } else {
        mobileMenu.classList.remove(
          'opacity-100',
          'pointer-events-auto',
          'translate-y-0',
        );
        mobileMenu.classList.add(
          'opacity-0',
          'pointer-events-none',
          '-translate-y-2',
        );
        bar1.classList.remove('translate-y-2', 'rotate-45');
        bar2.classList.remove('opacity-0', 'scale-0');
        bar3.classList.remove('-translate-y-2', '-rotate-45');
      }
    });

    // Ha a felhasználó átméretezi a kijelzőt a mobil töréspont fölé, alaphelyzetbe állítjuk a menüt
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) {
        menuToggle.click();
        menuToggle.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && isOpen) {
        menuToggle.click();
      }
    });
  }
</script>
