---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
  level: 1 | 2 | 3 | 4 | 5 | 6;
}
const { level } = Astro.props;
const maxCircles = 6;
const t = useTranslations(getLangFromUrl(Astro.url));
const label = t('skill.level')
  .replace('{level}', String(level))
  .replace('{max}', String(maxCircles));
---

<div class="flex gap-1.5" role="img" aria-label={label}>
  {
    Array.from({ length: maxCircles }).map((_, index) => (
      <span
        class={`w-3 h-3 rounded-full border border-slate-950 transition-colors ${
          index < level ? 'bg-slate-950' : 'bg-transparent'
        }`}
      />
    ))
  }
</div>
